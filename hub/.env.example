# Neon Postgres connection string from the Vercel Marketplace integration.
# Local Postgres works for development: postgresql://hub:hub@127.0.0.1:5432/hub_dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=

# Public origin of this hub only, for example https://hub.example.com
AUTH_URL=http://localhost:3000

# Magic-link sender. Resend SMTP looks like:
# smtp://resend:re_your_key@smtp.resend.com:465
EMAIL_SERVER=
EMAIL_FROM="Hub <hub@example.com>"

# Comma-separated invite list used by npm run db:seed.
# Roles are household (everything) or photos (photos page only).
SEED_ALLOWLIST=household@local.test:household,photos@local.test:photos

# Development only. Never set this in production.
AUTH_DEV_LOGIN=true

# Optional. Set to neon to force the Neon HTTP driver.
# DATABASE_DRIVER=neon

# Bearer token for POST /api/trading/ingest. Write-only. Leave unset to reject ingest.
# openssl rand -base64 32
TRADING_INGEST_TOKEN=
